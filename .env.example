# Copy to .env for local development. Never commit .env. Read with django-dotenv; real environment
# variables always win over this file.
#
# Environment flag: dev | prod (default prod, fails safe). Selects the logging profile, the log
# directory (logs/dev or logs/prod) and the DEBUG default. DJANGO_DEBUG=true is rejected unless dev.
DJANGO_ENV=dev
# Optional overrides:
#   DJANGO_DEBUG=true|false         (default: true in dev, false in prod)
#   DJANGO_LOG_LEVEL=DEBUG|INFO|... (default: DEBUG in dev, INFO in prod)
#   DJANGO_LOG_DIR=/path            (default: ./logs; the dev|prod subfolder is added automatically)
DJANGO_DEBUG=true
# Required when DJANGO_DEBUG=false. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://coach:coach@localhost:55432/coachsurmesure

# Email (development prints emails to the console; production needs SMTP and the public site URL):
#   DJANGO_SITE_URL=…
#   DJANGO_EMAIL_HOST=…  DJANGO_EMAIL_PORT=…  DJANGO_EMAIL_USER=…  DJANGO_EMAIL_PASSWORD=…
#   DJANGO_EMAIL_TLS=…  DJANGO_EMAIL_TIMEOUT=…  DJANGO_EMAIL_BACKEND=…
# Sender of all mails is "DJANGO_CONTACT_NAME <DJANGO_CONTACT_MAIL>":
#   DJANGO_CONTACT_NAME=…  DJANGO_CONTACT_MAIL=…

# Mail queue: the API only queues emails; run `python manage.py send_mail_outbox` as a separate process
# (dev shortcut without worker: DJANGO_MAILER_INLINE=true sends inside the request).
